# Cloudflare Pages headers — copied verbatim into site/dist on every build.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

/tools/*
  # Tool pages are HTML documents whose script ships with the page — a stale
  # copy here is a stale TOOL. Cache only in shared CDNs for failover traffic
  # bursts; browsers must always revalidate so a new deployment is live the
  # moment it exists (a user hit a day-old page from browser cache before).
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=300

/favicon.svg
  Cache-Control: public, max-age=604800, immutable

/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=3600
